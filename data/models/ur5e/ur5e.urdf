<?xml version="1.0" ?>
<!--
  UR5e Robot Arm - Simplified URDF for Foxglove Visualization
  
  Uses primitive geometries (cylinders, boxes) for fast rendering
  without external mesh dependencies. Based on Universal Robots UR5e
  DH parameters and link dimensions.
  
  Reference: Universal Robots UR5e Technical Details
    - Reach: 850 mm
    - Payload: 5 kg
    - 6 revolute joints
-->
<robot name="ur5e" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Colors -->
  <material name="ur_dark_blue">
    <color rgba="0.13 0.25 0.38 1.0"/>
  </material>
  <material name="ur_light_blue">
    <color rgba="0.40 0.60 0.80 1.0"/>
  </material>
  <material name="ur_silver">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>
  <material name="ur_black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <!-- Base Link (mounting plate) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.02"/>
      </geometry>
      <material name="ur_dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <inertia ixx="0.00443" ixy="0.0" ixz="0.0"
               iyy="0.00443" iyz="0.0"
               izz="0.0072"/>
    </inertial>
  </link>

  <!-- Shoulder (Joint 1) -->
  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.060" length="0.08"/>
      </geometry>
      <material name="ur_dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.060" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.7"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <inertia ixx="0.010267" ixy="0.0" ixz="0.0"
               iyy="0.010267" iyz="0.0"
               izz="0.00666"/>
    </inertial>
  </link>

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.1625" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" velocity="3.14" effort="150.0"/>
  </joint>

  <!-- Upper Arm (Joint 2) -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.2125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.054" length="0.425"/>
      </geometry>
      <material name="ur_light_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.060" length="0.06"/>
      </geometry>
      <material name="ur_dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.2125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.054" length="0.425"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="8.393"/>
      <origin xyz="0 0 0.2125" rpy="0 0 0"/>
      <inertia ixx="0.133886" ixy="0.0" ixz="0.0"
               iyy="0.133886" iyz="0.0"
               izz="0.0151074"/>
    </inertial>
  </link>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.08" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" velocity="3.14" effort="150.0"/>
  </joint>

  <!-- Forearm (Joint 3) -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.1945" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.040" length="0.3922"/>
      </geometry>
      <material name="ur_light_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.054" length="0.06"/>
      </geometry>
      <material name="ur_dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1945" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.040" length="0.3922"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.275"/>
      <origin xyz="0 0 0.1945" rpy="0 0 0"/>
      <inertia ixx="0.031209" ixy="0.0" ixz="0.0"
               iyy="0.031209" iyz="0.0"
               izz="0.004095"/>
    </inertial>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 -0.1333 0.425" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" velocity="3.14" effort="28.0"/>
  </joint>

  <!-- Wrist 1 (Joint 4) -->
  <link name="wrist_1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.05"/>
      </geometry>
      <material name="ur_dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.219"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0025599" ixy="0.0" ixz="0.0"
               iyy="0.0025599" iyz="0.0"
               izz="0.0021942"/>
    </inertial>
  </link>

  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 0.3922" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" velocity="6.28" effort="12.0"/>
  </joint>

  <!-- Wrist 2 (Joint 5) -->
  <link name="wrist_2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.05"/>
      </geometry>
      <material name="ur_dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.219"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0025599" ixy="0.0" ixz="0.0"
               iyy="0.0025599" iyz="0.0"
               izz="0.0021942"/>
    </inertial>
  </link>

  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0.0997 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" velocity="6.28" effort="12.0"/>
  </joint>

  <!-- Wrist 3 / Tool Flange (Joint 6) -->
  <link name="wrist_3_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="ur_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1879"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000132" ixy="0.0" ixz="0.0"
               iyy="0.000132" iyz="0.0"
               izz="0.0001764"/>
    </inertial>
  </link>

  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 -0.0996 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" velocity="6.28" effort="12.0"/>
  </joint>

  <!-- Tool / End Effector -->
  <link name="tool0">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.010" length="0.02"/>
      </geometry>
      <material name="ur_silver"/>
    </visual>
  </link>

  <joint name="tool0_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="tool0"/>
    <origin xyz="0 0.0996 0" rpy="-1.5708 0 0"/>
  </joint>

</robot>
